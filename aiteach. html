        <label for="header-board">Education Board:</label>
        <select id="header-board" name="board">
          <option value="cbse" selected>CBSE</option>
          <option value="icse">ICSE</option>
          <option value="state">State Board</option>
          <option value="ib">IB (International Baccalaureate)</option>
          <option value="cambridge">Cambridge IGCSE / A-Levels</option>
          <option value="common-core">US Common Core</option>
        </select>

        <button type="submit">Apply Context (Requires Backend)</button>
      </fieldset>
